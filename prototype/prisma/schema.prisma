generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum VerificationStatus {
  unverified
  community_verified
  resident_verified
  owner_verified
}

enum PhotoTag {
  turn_here
  entrance
  building
  parking
}

model Location {
  id                 String             @id @default(cuid())
  name               String
  category           String             @default("Other")
  address            String
  description        String?
  entrance           String?
  finalDirections    String
  landmarks          String[]           @default([])
  lookFor            String?
  verificationStatus VerificationStatus @default(unverified)
  parentId           String?
  parent             Location?          @relation("LocationTree", fields: [parentId], references: [id], onDelete: SetNull)
  children           Location[]         @relation("LocationTree")
  level              LocationLevel      @default(place)
  visibility         Visibility         @default(public)
  lat                Float?
  lng                Float?
  createdById        String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  photos             LocationPhoto[]
  claims             Claim[]
  corrections        Correction[]
  alerts             Alert[]
  arrivals           ArrivalReport[]

  @@index([name])
  @@index([parentId])
}

model LocationPhoto {
  id          String   @id @default(cuid())
  locationId  String
  location    Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  tag         PhotoTag
  url         String
  createdById String?
  createdAt   DateTime @default(now())

  @@index([locationId])
}

enum ClaimStatus {
  pending
  approved
  rejected
}

enum CorrectionStatus {
  pending
  confirmed
  dismissed
}

model Claim {
  id          String      @id @default(cuid())
  locationId  String
  location    Location    @relation(fields: [locationId], references: [id], onDelete: Cascade)
  claimantId  String?
  claimantNote String?
  status      ClaimStatus @default(pending)
  decidedBy   String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([locationId])
  @@index([status])
}

model Correction {
  id         String           @id @default(cuid())
  locationId String
  location   Location         @relation(fields: [locationId], references: [id], onDelete: Cascade)
  type       String
  detail     String
  status     CorrectionStatus @default(pending)
  reporterId String?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@index([locationId])
  @@index([status])
}

enum AlertType {
  construction
  checkpoint
  congestion
  closure
  accident
  flood
  event
  diversion
}

enum AlertStatus {
  active
  cleared
  expired
}
model Alert {
  id          String      @id @default(cuid())
  locationId  String?
  location    Location?   @relation(fields: [locationId], references: [id], onDelete: Cascade)
  roadHint    String?
  type        AlertType
  detail      String
  reportedAt  DateTime    @default(now())
  expiresAt   DateTime
  status      AlertStatus @default(active)
  confirms    Int         @default(0)
  reporterId  String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([locationId])
  @@index([status])
}

enum LocationLevel {
  estate
  block
  building
  floor
  unit
  shop
  place
}

enum Visibility {
  public
  private_link
  approved
}

enum OrderStatus {
  pending
  paid
  failed
  cancelled
}

enum PaymentStatus {
  pending
  success
  failed
}

model Order {
  id           String      @id @default(cuid())
  payerId      String?
  amountKobo   Int
  currency     String      @default("NGN")
  status       OrderStatus @default(pending)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  payments     Payment[]
  installments InstallmentPlan[]

  @@index([status])
}

model Payment {
  id         String        @id @default(cuid())
  orderId    String
  order      Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider   String        @default("paystack")
  reference  String        @unique
  status     PaymentStatus @default(pending)
  rawPayload Json?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([orderId])
}

model InstallmentPlan {
  id           String      @id @default(cuid())
  orderId      String
  order        Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  scheduleJson Json
  status       OrderStatus @default(pending)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([orderId])
}

model ArrivalReport {
  id         String   @id @default(cuid())
  locationId String
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  helpful    Boolean
  createdAt  DateTime @default(now())

  @@index([locationId])
}

model AbuseReport {
  id         String   @id @default(cuid())
  targetType String
  targetId   String
  reason     String
  status     String   @default("pending")
  createdAt  DateTime @default(now())

  @@index([status])
}

enum Role {
  CUSTOMER
  QUBATORS_ADMIN
  CONSULTANT
}

// Auth.js v5 models (Prisma adapter lands with the Postgres cutover;
// JWT strategy below works DB-less locally).
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  role          Role      @default(CUSTOMER)
  accounts      Account[]
  sessions      Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
