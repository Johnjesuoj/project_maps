generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum VerificationStatus {
  unverified
  community_verified
  resident_verified
  owner_verified
}

enum PhotoTag {
  turn_here
  entrance
  building
  parking
}

model Location {
  id                 String             @id @default(cuid())
  name               String
  category           String             @default("Other")
  address            String
  description        String?
  entrance           String?
  finalDirections    String
  landmarks          String[]           @default([])
  lookFor            String?
  verificationStatus VerificationStatus @default(unverified)
  parentId           String?
  parent             Location?          @relation("LocationTree", fields: [parentId], references: [id], onDelete: SetNull)
  children           Location[]         @relation("LocationTree")
  level              LocationLevel      @default(place)
  lat                Float?
  lng                Float?
  createdById        String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  photos             LocationPhoto[]
  claims             Claim[]
  corrections        Correction[]
  alerts             Alert[]

  @@index([name])
  @@index([parentId])
}

model LocationPhoto {
  id          String   @id @default(cuid())
  locationId  String
  location    Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  tag         PhotoTag
  url         String
  createdById String?
  createdAt   DateTime @default(now())

  @@index([locationId])
}

enum ClaimStatus {
  pending
  approved
  rejected
}

enum CorrectionStatus {
  pending
  confirmed
  dismissed
}

model Claim {
  id          String      @id @default(cuid())
  locationId  String
  location    Location    @relation(fields: [locationId], references: [id], onDelete: Cascade)
  claimantId  String?
  claimantNote String?
  status      ClaimStatus @default(pending)
  decidedBy   String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([locationId])
  @@index([status])
}

model Correction {
  id         String           @id @default(cuid())
  locationId String
  location   Location         @relation(fields: [locationId], references: [id], onDelete: Cascade)
  type       String
  detail     String
  status     CorrectionStatus @default(pending)
  reporterId String?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@index([locationId])
  @@index([status])
}

enum AlertType {
  construction
  checkpoint
  congestion
  closure
  accident
  flood
  event
  diversion
}

enum AlertStatus {
  active
  cleared
  expired
}
model Alert {
  id          String      @id @default(cuid())
  locationId  String?
  location    Location?   @relation(fields: [locationId], references: [id], onDelete: Cascade)
  roadHint    String?
  type        AlertType
  detail      String
  reportedAt  DateTime    @default(now())
  expiresAt   DateTime
  status      AlertStatus @default(active)
  confirms    Int         @default(0)
  reporterId  String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([locationId])
  @@index([status])
}

enum LocationLevel {
  estate
  block
  building
  floor
  unit
  shop
  place
}

enum OrderStatus {
  pending
  paid
  failed
  cancelled
}

enum PaymentStatus {
  pending
  success
  failed
}

model Order {
  id           String      @id @default(cuid())
  payerId      String?
  amountKobo   Int
  currency     String      @default("NGN")
  status       OrderStatus @default(pending)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  payments     Payment[]
  installments InstallmentPlan[]

  @@index([status])
}

model Payment {
  id         String        @id @default(cuid())
  orderId    String
  order      Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider   String        @default("paystack")
  reference  String        @unique
  status     PaymentStatus @default(pending)
  rawPayload Json?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([orderId])
}

model InstallmentPlan {
  id           String      @id @default(cuid())
  orderId      String
  order        Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  scheduleJson Json
  status       OrderStatus @default(pending)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([orderId])
}
